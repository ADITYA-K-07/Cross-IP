# Required for the four live analysis routes.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
# Use model IDs available to your own accounts. The defaults are conservative
# structured-output capable choices at the time this project was created.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated frontend origins. Local Next.js runs on port 3000.
ALLOWED_ORIGINS=http://localhost:3000
UPSTREAM_TIMEOUT_SECONDS=15
# Groq and Gemini can require longer than a web-search request for structured output.
MODEL_TIMEOUT_SECONDS=45
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
